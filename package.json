  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "trap 'kill 0' EXIT; node server/index.mjs & vite",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
