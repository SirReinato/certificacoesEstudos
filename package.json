    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "readability": "^0.1.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.2",
    "madge": "^8.0.0",
    "oxlint": "^1.88.0",
