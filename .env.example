# ==============================================================================
# SAFEZONE STUDIES — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env ou .env.local e preencha com as suas credenciais.
# NUNCA comite arquivos .env ou .env.local com chaves reais no repositório.
# ==============================================================================

# --- SUPABASE BAAS (Obrigatório para autenticação, PostgreSQL e Storage) ---
# Obtenha no painel do Supabase: Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# --- PROVEDORES DE IA (Opcionais via .env — podem ser informados na UI /config) ---
# Google Gemini (Padrão para geração de apostilas 30/70 e flashcards)
VITE_GEMINI_API_KEY=

# NVIDIA NIM (Llama 3.3 70B via endpoint /api/nvidia)
VITE_NVIDIA_API_KEY=

# OpenAI / Azure OpenAI / Anthropic (Alternativos)
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_AZURE_OPENAI_API_KEY=
VITE_AZURE_OPENAI_ENDPOINT=
